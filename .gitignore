/target
/target-shared
/.claude/runtime/
.cargo/config.toml
__pycache__/
*.pyc
logs/
.amplihack/
worktrees/
worktrees
node_modules/
test-results/
gym-wave*-tmp/

# Rust coverage artifacts (llvm-cov / cargo-llvm-cov)
# Emitted into CWD when tests run without `LLVM_PROFILE_FILE` redirection.
*.profraw
*.profdata

# Per-process engineer claim files written by the multi-worktree orchestrator;
# never useful in version control.
.simard-engineer-claim

# Per-script audit output (issue #1990 / epic). Belt-and-suspenders with scripts/dashboard_audit/.gitignore.
scripts/dashboard_audit/out/
# Playwright self-understanding audit captures (issues #1170 / #1630 / #1992).
tests/e2e-dashboard/.audit-output/
.simard/bin/simard.bak.*
.local/

# Stray runtime OTel/tracing log dump occasionally written to the repo root;
# a runtime artifact, never source (issue #4505 outside-in cleanup).
/err.log

# mkdocs build output
/site/

# Generated dashboard-audit screenshots/reports (regenerated locally; not source)
scripts/dashboard-audit/out/

# Guard: never commit stray PR/engineer worktree dirs as gitlinks (breaks release checkout submodule step)
pr*-worktree/
*-worktree/
.simard/
