digraph ServiceComponentsRuntime {
  rankdir=TB;
  graph [fontname="Arial", fontsize=10, labelloc=t, label="Runtime OODA component graph"];
  node [shape=box, style="rounded,filled", fillcolor="#fffdf5", color="#8a6f3d", fontname="Arial", fontsize=9];
  edge [color="#6e6250", fontname="Arial", fontsize=8];

  daemon [label="operator_commands_ooda::daemon"];
  brains [label="daemon::brains"];
  persistence [label="operator_commands_ooda::persistence"];
  dashboard [label="operator_commands_dashboard"];
  run_cycle [label="ooda_loop::run_ooda_cycle"];
  observe [label="observe"];
  orient [label="orient"];
  decide [label="decide"];
  act [label="act"];
  curate [label="curate"];
  phase_weights [label="phase_weights"];
  coverage [label="coverage"];
  no_progress [label="no_progress"];
  dispatch [label="dispatch_actions_bounded"];
  concurrent [label="ooda_actions::concurrent"];
  spawn [label="advance_goal::spawn"];
  goal_session [label="goal_session"];
  typed_session [label="typed_goal_session"];
  typed_ledger [label="typed_ooda::CapabilityHandler"];
  brain_traits [label="OODA brain traits"];
  recipe_brain [label="RecipeBrain"];
  prompt_store [label="prompt_store"];
  memory_ops [label="CognitiveMemoryOps"];
  memory_ipc [label="memory_ipc"];
  memory_consolidation [label="memory_consolidation"];
  goal_curation [label="goal_curation"];
  goal_board_store [label="goal_board_store"];
  engineer_worktree [label="engineer_worktree"];
  threads [label="cognitive_threads::Mind"];
  overseer_tick [label="overseer tick"];
  journal_tick [label="journal tick"];
  self_metrics [label="self_metrics"];
  telemetry [label="telemetry"];

  daemon -> brains;
  daemon -> persistence;
  daemon -> dashboard;
  daemon -> run_cycle;
  daemon -> goal_board_store;
  daemon -> memory_ipc;
  daemon -> threads;
  daemon -> overseer_tick;
  daemon -> journal_tick;
  daemon -> self_metrics;
  daemon -> telemetry;
  brains -> brain_traits;
  brains -> recipe_brain;
  brains -> prompt_store;
  run_cycle -> observe;
  run_cycle -> orient;
  run_cycle -> decide;
  run_cycle -> act;
  run_cycle -> curate;
  run_cycle -> coverage;
  run_cycle -> no_progress;
  observe -> memory_ops;
  observe -> memory_consolidation;
  orient -> brain_traits;
  orient -> goal_curation;
  orient -> phase_weights;
  decide -> brain_traits;
  act -> dispatch;
  curate -> goal_curation;
  curate -> goal_board_store;
  curate -> memory_consolidation;
  no_progress -> goal_curation;
  no_progress -> dispatch;
  dispatch -> concurrent;
  dispatch -> spawn;
  dispatch -> goal_session;
  dispatch -> typed_session;
  concurrent -> memory_ops;
  concurrent -> brain_traits;
  spawn -> brain_traits;
  spawn -> engineer_worktree;
  goal_session -> memory_ops;
  goal_session -> goal_curation;
  typed_session -> typed_ledger;
  typed_session -> engineer_worktree;
  typed_ledger -> goal_board_store;
}
