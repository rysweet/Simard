digraph ServiceComponentsOperator {
  rankdir=TB;
  graph [fontname="Arial", fontsize=10, labelloc=t, label="Operator, dashboard, and meetings component graph"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f8ff", color="#626a9d", fontname="Arial", fontsize=9];
  edge [color="#5c6075", fontname="Arial", fontsize=8];

  main [label="src/main.rs"];
  operator_cli [label="operator_cli"];
  operator_commands [label="operator_commands"];
  ooda_cli [label="operator_cli::ooda"];
  memory_cli [label="operator_cli::memory"];
  status_cli [label="operator_cli::status"];
  meeting_cli [label="operator_cli::meeting"];
  signal_cli [label="operator_cli::signal"];
  dashboard [label="operator_commands_dashboard"];
  routes [label="dashboard::routes"];
  dash_memory [label="dashboard::memory"];
  dash_goals [label="dashboard::goals"];
  dash_chat [label="dashboard::chat"];
  dash_overseer [label="dashboard::overseer"];
  dash_metrics [label="dashboard::metrics"];
  meeting_backend [label="meeting_backend::MeetingBackend"];
  meeting_persist [label="meeting_backend::persist"];
  meeting_facilitator [label="meeting_facilitator"];
  meetings [label="meetings persisted records"];
  conversation_channel [label="conversation_channel"];
  signal_conversation [label="signal_conversation"];
  chat_store [label="dashboard::chat_store"];
  goal_curation [label="goal_curation"];
  goal_board_store [label="goal_board_store"];
  memory_ipc [label="memory_ipc"];
  cognitive_memory [label="cognitive_memory"];
  status [label="status::assemble"];
  telemetry [label="telemetry"];
  overseer [label="overseer"];
  journal [label="journal"];
  typed_ooda [label="typed_ooda"];

  main -> operator_cli;
  operator_cli -> operator_commands;
  operator_cli -> ooda_cli;
  operator_cli -> memory_cli;
  operator_cli -> status_cli;
  operator_cli -> meeting_cli;
  operator_cli -> signal_cli;
  ooda_cli -> typed_ooda;
  memory_cli -> memory_ipc;
  memory_cli -> cognitive_memory;
  status_cli -> status;
  meeting_cli -> meeting_facilitator;
  signal_cli -> signal_conversation;
  dashboard -> routes;
  routes -> dash_memory;
  routes -> dash_goals;
  routes -> dash_chat;
  routes -> dash_overseer;
  routes -> dash_metrics;
  dash_memory -> cognitive_memory;
  dash_memory -> memory_ipc;
  dash_goals -> goal_curation;
  dash_goals -> goal_board_store;
  dash_chat -> meeting_backend;
  dash_chat -> chat_store;
  dash_overseer -> overseer;
  dash_metrics -> telemetry;
  dash_metrics -> journal;
  meeting_backend -> meeting_persist;
  meeting_backend -> conversation_channel;
  meeting_persist -> meeting_facilitator;
  meeting_persist -> meetings;
  meeting_persist -> cognitive_memory;
  meeting_facilitator -> goal_curation;
  meeting_facilitator -> cognitive_memory;
  signal_conversation -> conversation_channel;
  conversation_channel -> meeting_backend;
}
