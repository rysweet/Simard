digraph ServiceComponentsOverview {
  rankdir=TB;
  graph [fontname="Arial", fontsize=10, labelloc=t, label="Simard service components overview"];
  node [shape=box, style="rounded,filled", fillcolor="#f9fff8", color="#597a5b", fontname="Arial", fontsize=9];
  edge [color="#5f6d5f", fontname="Arial", fontsize=8];

  daemon [label="OODA daemon and scheduler"];
