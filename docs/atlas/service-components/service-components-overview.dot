  gym [label="Gym and benchmarking"];
  self_improve [label="Self-improve and self-deploy"];
  signal [label="Signal conversation"];
  operator [label="Operator CLI and dashboard"];
  journal [label="Journal"];
  telemetry [label="Telemetry and self-metrics"];

  daemon -> ooda [label="runs cycle"];
