digraph DataFlowEngineer { rankdir=LR; node [shape=box, style="rounded,filled", fillcolor="#f8fbff", fontname="Arial"];
  action -> rails -> live -> repo -> admission -> worktree -> fresh -> subordinate -> tmux -> single -> prompt -> agent -> pr -> merge -> deploy; subordinate -> registry;
  action [label="PlannedAction spawn_engineer"]; rails [label="identity/read-only rails"]; live [label="assigned/live checks"]; repo [label="resolve target repo"]; admission [label="overlap/resource admission"]; worktree [label="EngineerWorktree::allocate"]; fresh [label="ensure_amplihack_fresh"]; subordinate [label="spawn_subordinate"]; tmux [label="tmux/direct child"]; single [label="simard engineer run single-process"]; prompt [label="build_agent_prompt + standards"]; agent [label="amplihack copilot/RustyClawd"]; pr [label="agent uses git/gh to open PR"]; merge [label="merge authority/operator"]; deploy [label="self-deploy candidate"]; registry [label="subagent_sessions registry"];
}
