// Simard Code Atlas — Agentic Flow: the Overseer tick (DOT rendering)
// Code truth: src/overseer/wiring.rs, mod.rs, sensor.rs, signal.rs, root_cause.rs, intervention.rs
digraph overseer_tick {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, style=rounded];
  edge [fontname="Helvetica", fontsize=8];

  entry [label="wiring::overseer_tick\n-> overseer_tick_detailed (panic-isolated)"];

  subgraph cluster_pre {
    label="pre-cycle reconciliation (run_cycle preamble)"; style=rounded; color="#886644";
    recon [label="reconcile_inflight_investigations"];
    reap  [label="reap_stale_engineer_claims (fail-closed)"];
    seq   [label="sequencer.reset()"];
    recon -> reap -> seq;
  }
  entry -> recon;

  subgraph cluster_obs {
    label="OBSERVE -> ObservedState"; style=rounded; color="#446688";
    st   [label="caps.status.snapshot()"];
    gb   [label="caps.goals.observe_board()\nblocked + in-flight"];
    gap  [label="caps.goals.workstream_gaps()"];
    prs  [label="caps.prs.survey_ready_prs()"];
    fail [label="failure_sink::drain_recent()"];
    rec  [label="recall_pass() -> MemorySnapshot"];
  }
  seq -> st;

  sig    [label="SIGNAL: signals_from(observed)"];
  orient [label="ORIENT: observer::orient\n(dedup vs in-flight) -> Problem[]"];
  why    [label="ROOT-CAUSE (#2635)\nroot_cause::analyze -> WHY"];
  decide [label="DECIDE: decide(problem) -> Intervention"];
  gate   [label="GATE guardrails\nAutonomy/Recursion/Budget/Conflict/Whisper/Backoff"];
  st -> sig; gb -> sig; gap -> sig; prs -> sig; fail -> sig; rec -> sig;
  sig -> orient -> why -> decide -> gate;

  eco [label="ecosystem_observe (cadence)\nagentic gh cross-repo survey"];
  st -> eco [style=dashed]; eco -> decide [style=dashed];

  subgraph cluster_act {
    label="ACT: dispatch admitted Interventions (Overseer::act)"; style=rounded; color="#448844";
    lr  [label="LaunchRecipe -> RecipeLauncher (smart-orchestrator)"];
    mp  [label="VerifyAndMergePr -> PrOps"];
    dp  [label="Deploy -> GuardedDeployer"];
    fi  [label="FileIssue -> StewardshipIssueFiler"];
    esc [label="Escalate(BlockedGoal) -> OperatorNotifier + escalation_triage"];
    wh  [label="Whisper -> WhisperSink"];
    ub  [label="UnblockGoal -> GoalCurator.unblock"];
  }
  gate -> lr; gate -> mp; gate -> dp; gate -> fi; gate -> esc; gate -> wh; gate -> ub;

  rec2   [label="record_occurrence(entry, outcome)"];
  report [label="OverseerTickReport"];
  lr -> rec2; mp -> rec2; dp -> rec2; fi -> rec2; esc -> rec2; wh -> rec2; ub -> rec2;
  rec2 -> report;

  mem [label="cognitive memory (lbug)", shape=cylinder, style=filled, fillcolor="#eeffee"];
  rec -> mem; rec2 -> mem;
  recipes [label="Recipes flow (smart-orchestrator)", style="rounded,filled", fillcolor="#ffeeee"];
  lr -> recipes; esc -> recipes;
}
