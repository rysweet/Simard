// Simard Code Atlas — Agentic Flow: typed-OODA capability / effect model (DOT rendering)
// Code truth: src/typed_ooda/{route.rs,ledger.rs,executor.rs,types.rs,schema.rs}
digraph typed_ooda {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, style=rounded];
  edge [fontname="Helvetica", fontsize=8];

  act   [label="OODA Act / Overseer\nchooses a typed request", style="rounded,filled", fillcolor="#ffeeee"];
  route [label="route::TypedGoalSessionRoute::execute\nvalidate assets == TRUSTED_RECIPE/POLICY"];
  act -> route;

  subgraph cluster_ledger {
    label="LEDGER: CapabilityHandler (SQLite outcomes.sqlite3)"; style=rounded; color="#446688";
    open    [label="CapabilityHandler::open\nload CapabilityPolicy"];
    session [label="register_actor_session\n-> ActorSessionLease (token+TTL)"];
    authz   [label="AuthenticatedToolContext.allows(grant)"];
    admit   [label="AdmissionSnapshot\nengineers/disk%/claims/policy_rev"];
    open -> session -> authz -> admit;
  }
  route -> open;

  subgraph cluster_term {
    label="TERMINAL OUTCOME (single per session,cycle)"; style=rounded; color="#886644";
    ra [label="record_action\nSpawnEngineer|FileIssue|RequestMerge|RequestDeploy"];
    rn [label="record_no_action"];
    rb [label="record_blocked"];
    rc [label="record_completed"];
    rp [label="record_progress"];
  }
  admit -> ra; admit -> rn; admit -> rb; admit -> rc; admit -> rp;

  outcome [label="terminal_outcomes\nUNIQUE(session_id,cycle_id)\nidempotent replay", shape=cylinder, style=filled, fillcolor="#eeffee"];
  ra -> outcome; rn -> outcome; rb -> outcome; rc -> outcome;

  subgraph cluster_eff {
    label="EFFECT JOB LIFECYCLE (effect_jobs)"; style=rounded; color="#448844";
    ej    [label="EffectJob {effect_id,outcome_id,kind,state}"];
    lease [label="lease: attempt/generation/owner/expires_at"];
    exec  [label="EffectExecutor::execute\nReserved->Running->Completed|Failed"];
    ej -> lease -> exec;
  }
  outcome -> ej [label="action outcome enqueues effect"];

  claims [label="engineer_claims\nsingle active per engineer/repo", shape=cylinder, style=filled, fillcolor="#eeffee"];
  ra -> claims [label="SpawnEngineer"];
  liveness [label="EngineerLiveness -> release_engineer_claim"];
  claims -> liveness [style=dashed];

  recipe [label="goal-session-actor recipe\nrecipe-runner-rs (agentic-recipes)", style="rounded,filled", fillcolor="#ffeeee"];
  route -> recipe [label="ContextFile: task/reason/observe/orient/decide + auth_token"];
  recipe -> ra [label="GoalSessionTools callbacks (executor.rs)", style=dashed];

  eng [label="engineer_loop / agent_supervisor\n(engineer-pr journey)", style="rounded,filled", fillcolor="#ffeeee"];
  exec -> eng [label="SpawnEngineer effect"];
}
