flowchart TD
  %% Layer 9 - Agentic flow: the Overseer meta-OODA tick (agentic merge-queue + issue reasoning)
  tick["run_overseer_tick_isolated_detailed (panic-isolated)\nsrc/overseer/wiring.rs"]
  tick --> cycle["run_cycle  src/overseer/mod.rs:609"]

  subgraph OBSERVE
    snap["StatusReader::snapshot -> ObservedState\n(distill fail%, restart churn, LLM budget, anomalies)"]
    board["GoalCurator::observe_board (blocked goals + in-flight)"]
    gaps["GoalCurator::workstream_gaps (coverage gaps)"]
    prs["PrOps::survey_ready_prs (SIMARD_AUTOMERGE_REPOS)"]
    mq["observe_merge_queue -> observe-merge-queue.yaml\nagentic PR/issue reasoning  src/overseer/mod.rs:875"]
    fails["failure_sink::drain_recent (step/engineer/terminal failures)"]
    recall["recall_pass(keys) -> MemorySnapshot\n(cognitive-memory recall path)  src/overseer/mod.rs:1026"]
  end
  cycle --> snap --> board --> gaps --> prs --> mq --> fails --> recall

  recall --> orient["ORIENT signals_from(observed) -> orient(signals,in_flight)\n-> Vec&lt;Problem&gt;  src/overseer/mod.rs:2165"]
  orient --> why["ROOT-CAUSE root_cause::analyze(problem, observed, recall)\n+ recall_occurrences (recurrence)  src/overseer/root_cause.rs"]
  why --> decide["DECIDE decide(problem) -> Intervention\nsrc/overseer/mod.rs:2467"]
  decide --> gate["GATE gate(iv, observed, launches) -> PlannedIntervention\n(autonomy / budget / conflict / recursion)  src/overseer/mod.rs:1156"]
  gate --> eco["observe_ecosystem (after decide/gate loop) ->\necosystem-observe.yaml -> gated Intervention::LaunchRecipe\nsrc/overseer/ecosystem_observe.rs"]
  eco --> act["ACT execute plan via overseer capabilities  src/overseer/capabilities.rs"]

  act --> notify["NotifierOps (email + Signal RPC :7583)"]
  act --> issue["IssueFiler -> gh (dedup by failure_signature)"]
  act --> launch["RecipeLauncher -> amplihack recipe run smart-orchestrator\nsrc/overseer/launch.rs"]
  act --> merge["MergePrOps (poll-until-green, notify-on-merge)"]
  act --> deploy["Deployer = RefuseDeployer (production):\nrefuses autonomous deploy, defers to operator gates\nsrc/overseer/wiring.rs:1068"]
  act --> goalcap["GoalCurator unblock/escalate; MeetingHost transfer_goal"]

  act --> writeback["record_observation -> store_episode('overseer')\nwrite-back to lbug (dedup gate)"]
  writeback -->|write| store["(cognitive-memory / lbug, in-process)"]
  recall -->|read| store

  classDef recipe fill:#fff6df,stroke:#d9a441;
  classDef memory fill:#eaf6ff,stroke:#4a90d9;
  class mq,eco,launch recipe;
  class recall,writeback,store memory;
