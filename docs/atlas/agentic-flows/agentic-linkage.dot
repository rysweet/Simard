// Simard Code Atlas — Agentic Flow: cross-layer linkage (DOT rendering)
// How the six agentic flows interlock across atlas layers.
digraph agentic_linkage {
  rankdir=LR;
  node [shape=box, fontname="Helvetica", fontsize=10, style=rounded];
  edge [fontname="Helvetica", fontsize=8];

  subgraph cluster_l4 {
    label="runtime-topology + service-components (one native daemon)"; style=rounded; color="#446688";
    daemon   [label="operator_commands_ooda::daemon (tick scheduler)"];
    ooda     [label="OODA loop\nobserve/orient/decide/act/curate"];
    overseer [label="Overseer tick (meta-OODA)"];
    memipc   [label="memory-ipc / CognitiveMemoryOps"];
  }

  subgraph cluster_l6 {
    label="data-flow (capability + effect + memory)"; style=rounded; color="#886644";
    typed  [label="typed-OODA capability/effect ledger\n(outcomes.sqlite3)"];
    recall [label="cognitive recall\nobjective probe -> PreparedContext"];
  }

  subgraph cluster_assets {
    label="prompt assets + recipes (agentic decision surface)"; style=rounded; color="#448844";
    prompts [label="prompt_assets/simard/*"];
    recipes [label="recipes -> recipe-runner-rs\nsmart-orchestrator/default-workflow/investigation-workflow"];
    agent   [label="semantic agent (LLM)", style="rounded,filled", fillcolor="#ffeeee"];
  }

  store [label="lbug graph store\n<state_root>/cognitive", shape=cylinder, style=filled, fillcolor="#eeffee"];
  eng   [label="engineer_loop / agent_supervisor -> PR", style="rounded,filled", fillcolor="#ffeeee"];

  daemon -> ooda [label="run_ooda_cycle"];
  daemon -> overseer [label="overseer_tick"];
  ooda -> recall [label="prepare phase"];
  recall -> memipc [label="recall/store", dir=both];
  memipc -> store [dir=both];
  ooda -> recipes [label="orient/decide (brain)"];
  recipes -> prompts [label="reads"];
  recipes -> agent;
  recipes -> ooda [label="verdict"];

  ooda -> typed [label="Act: AdvanceGoal/SpawnEngineer"];
  typed -> recipes [label="goal-session-actor"];
  typed -> eng [label="SpawnEngineer effect"];
  typed -> store [label="terminal outcomes + claims"];

  overseer -> recall [label="recall_pass"];
  overseer -> recipes [label="LaunchRecipe/Escalate"];
  overseer -> memipc [label="record_occurrence"];
  overseer -> typed [label="reap_stale_engineer_claims"];

  eng -> daemon [label="PR + outcomes"];
  eng -> memipc [label="episodes/facts"];
}
