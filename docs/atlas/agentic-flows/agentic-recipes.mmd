flowchart TD
  %% Layer 9 - Agentic flow: recipes (amplihack recipe-runner invocation model)
  callers["Callers:\nOODA orient/decide/lifecycle (RecipeBrain)\nstewardship merge judge\njournal / disk-health / typed-OODA actor\noverseer merge-queue / ecosystem / smart-orchestrator"]
  callers --> resolve["resolve_recipe_path (precedence)\n1) ~/.simard/prompt_assets/simard/recipes/&lt;name&gt;.yaml (hot-reload)\n2) &lt;repo&gt;/prompt_assets/simard/recipes/&lt;name&gt;.yaml (in-tree)\nsrc/ooda_brain/recipe_brain.rs"]
  resolve --> precond["RecipeBrain::new preconditions:\nrecipe exists + recipe-runner-rs --version + agent binary resolves"]
  precond --> spawn0["(engineer-spawn path only) amplihack_freshness_gate\nruns 'amplihack update' pre-spawn  src/amplihack_freshness_gate/"]
  precond --> ctx["ContextFile (only when a var is large; else inline argv):\nlarge vars -> 0700 temp file, -c key_path=/tmp/... (avoids execve E2BIG)\nsrc/recipe_context_file.rs"]
  spawn0 --> spawn
  ctx --> spawn["Command::new(recipe-runner-rs)\n  arg(recipe_path) --output-format json\n  env AMPLIHACK_AGENT_BINARY  -c key=value ...\nOR: amplihack recipe run smart-orchestrator (overseer)"]
  spawn --> agent["agent binary (Copilot / Claude) runs recipe steps"]
  agent --> stdout["stdout envelope {success, step_results:[{step_id, output}]}"]
  stdout --> extract["recipe_output: strip_ansi + strip_recipe_noise\nextract_json_payload / extract_verdict\nsrc/recipe_output/extract.rs"]
  extract --> outcome["typed decision: OrientJudgment / DecideJudgment / Verdict\nrecord_parse_outcome(phase, ok) -> metrics.jsonl"]
  outcome --> back["returned to caller (OODA phase / merge gate / typed-OODA effect)"]

  %% recipe inventory
  inv["Recipe inventory (prompt_assets/simard/recipes/*.yaml):\nooda-orient, ooda-decide, ooda-engineer-admission/lifecycle,\nooda-resource-admission, ooda-no-progress-why, ooda-goal-outcome-verification,\ngoal-decomposition, goal-session-actor, merge-readiness-judge,\nobserve-merge-queue, ecosystem-observe, progress-assessment,\ndistill-episodes, journal-narrative/plain-language, disk-health-check/reclaim,\ncreative-idea-dedup/consolidation, brain-introspection, monthly-self-quality-audit"]
  resolve -.reads.-> inv
  spawn -.external.-> ext["smart-orchestrator / default-workflow / investigation-workflow\nlive in amplifier-bundle (downstream of amplihack), NOT this repo"]

  classDef recipe fill:#fff6df,stroke:#d9a441;
  class inv,ext recipe;
