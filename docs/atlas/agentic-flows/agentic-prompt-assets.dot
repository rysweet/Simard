// Simard Code Atlas — Agentic Flow: prompt assets (DOT rendering)
// Code truth: src/prompt_assets.rs, src/agent_roles.rs, src/typed_ooda/route.rs, prompt_assets/simard/*
digraph prompt_assets {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, style=rounded];
  edge [fontname="Helvetica", fontsize=8];

  subgraph cluster_tree {
    label="prompt_assets/simard/ (source of truth; derived to ~/.simard on deploy)"; style=rounded; color="#446688";
    md       [label="*.md prompts\nengineer_system, ooda_brain/orient/decide,\nmerge_readiness_judge, goal_decomposition, ..."];
    recipesY [label="recipes/*.yaml (embed .md text, {{var}})"];
    overseer [label="overseer/*.md"];
    policies [label="policies/goal-session-capabilities.toml"];
    terminal [label="terminal_recipes/*"];
  }

  subgraph cluster_rt {
    label="RUNTIME loading (prompt_assets.rs)"; style=rounded; color="#886644";
    trait [label="trait PromptAssetStore"];
    file  [label="FilePromptAssetStore {root}\nreject abs + '..'"];
    hot   [label="root: ~/.simard/prompt_assets (hot-reload)\nOR {repo_root}/prompt_assets (dev)"];
    trait -> file -> hot;
  }

  subgraph cluster_ct {
    label="COMPILE-TIME embeds (include_str!)"; style=rounded; color="#448844";
    gsi    [label="ooda_actions/goal_session/input.rs:126\ngoal_session_identity.md"];
    troute [label="typed_ooda/route.rs:18,20\ngoal-session-actor.yaml + capabilities.toml (TRUSTED_*)"];
    rev    [label="review_pipeline.rs:98\nreview_pipeline.md"];
    rc     [label="base_type_rustyclawd/execution.rs:15\nrustyclawd_default_system.md"];
  }

  roles [label="agent_roles::AgentRole::prompt_assets()\nEngineer/Reviewer/GymRunner/Facilitator"];
  idres [label="identity_precedence::resolver::resolve_prompt_assets()"];

  md -> file; overseer -> file; roles -> trait; idres -> trait;
  md -> recipesY [label="embedded verbatim", style=dashed];
  recipeflow [label="Recipes flow (recipe-runner-rs)", style="rounded,filled", fillcolor="#ffeeee"];
  recipesY -> recipeflow;
  policies -> troute;
  md -> gsi; md -> troute; md -> rev; md -> rc;

  consumers [label="consumers: engineer sessions, brains,\noverseer decisions, goal-session actor"];
  file -> consumers; gsi -> consumers; troute -> consumers; rev -> consumers; rc -> consumers;
}
