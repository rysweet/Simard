  subgraph Signal["Signal conversation"]
    ST["JsonRpcTransport<br/>TCP JSON-RPC lines"]
    SG["allowlist + risk gate"]
    SL["lifecycle<br/>/help /new /reset /close"]
    SLow["low-risk<br/>status pause approve"]
    SH["high-risk<br/>deploy merge #NNNN"]
    SC["ordinary text conversation"]
    ST --> SG
    SG --> SL
    SG --> SLow
    SG --> SH
    SG --> SC
  end

  subgraph Memory["Memory IPC"]
    MC["RemoteCognitiveMemory::call"]
    MR["MemoryRequest<br/>serde tag op"]
    MS["server::dispatch"]
    MP["MemoryResponse<br/>serde tag ok/value"]
    MG["guards<br/>0600 socket + MAX_FRAME + gated writes"]
    MC --> MR --> MS --> MP
    MS --> MG
  end

  subgraph Meeting["Meeting REPL"]
    REPL["run_meeting_repl()"]
    RC["control<br/>/help /close /done /status /export /recap /preview /state"]
    RCap["capture<br/>/decision /action /question /risk /disagree /theme /owner /goal"]
    RT["template<br/>/template [name]"]
    RN["natural conversation"]
    REPL --> RC
    REPL --> RCap
    REPL --> RT
    REPL --> RN
  end

  CS -->|dashboard serve| DR
