  subgraph CLI["Operator CLI"]
    CD["dispatch_operator_cli()"]
    CE["engineer"]
    CM["meeting"]
    CG["goal / curation"]
    CO["ooda"]
    CS["dashboard / signal / memory / status / spawn / merge-pr"]
    CX["maintenance<br/>worktree-gc/disk-reclaim/update/self-test/self-health/ci-health/self-deploy/safe-update"]
    CD --> CE
